<?xml version="1.0" encoding="utf-8"?>
<mujoco model="learn">
    <compiler angle="radian" autolimits="true"/>
    <option timestep="0.005" 
        gravity="0 0 -9.81" 
        integrator="implicitfast" 
        density="1.225" 
        viscosity="1.8e-5"
        solver="Newton"
        iterations="100"/>
    <visual>
        <global realtime="1"/>
        <quality shadowsize="2048"
            numslices="14"
            offsamples="2"/>
        <headlight diffuse="1 1 1" 
            specular="0.5 0.5 0.5" 
            active="1" />
        <rgba fog="0 1 0 1"
            haze="1 0 0 1" />
    </visual>
    <asset>
       <texture name="plane" 
            type="2d" 
            builtin="checker"
            rgb1=".1 .1 .1" rgb2=".9 .9 .9"
            width="512" 
            height="512"
            mark="cross" markrgb=".8 .8 .8" />
        <material name="plane" 
            reflectance="0.3" 
            texture="plane"
            texrepeat="1 1" 
            texuniform="true"/>
        <material name="red_plastic" 
            rgba="0.8 0.05 0.05 1"/>  
    </asset>
    <worldbody>
        <geom name="floor"
            type="plane"
            size="10 10 0.1"
            material="plane" />
        <body name="box" pos="0 0 1">
            <freejoint/>
            <geom    
                type="box"
                size="0.1 0.1 0.1"
                mass="1"
                material="red_plastic"
            />
        </body>
        <body name="base" pos="0 0 0.3">
            <geom type="cylinder" size="0.15 0.1"/>

            <!-- link1 是 base 的子刚体 -->
            <body name="link1" pos="0 0 0.1">
                <joint name="shoulder" type="hinge" axis="0 1 0"/>
                <geom type="capsule"
                    fromto="0 0 0 0 0 0.5"
                    size="0.04"
                    mass="1"/>

            <!-- link2 是 link1 的子刚体 -->
                <body name="link2" pos="0 0 0.5">
                    <joint name="elbow" type="hinge" axis="0 1 0"/>
                    <geom type="capsule"
                    fromto="0 0 0 0 0 0.4"
                    size="0.035"
                    mass="0.6"/>
                </body>
            </body>
        </body>
    </worldbody>
</mujoco>
        